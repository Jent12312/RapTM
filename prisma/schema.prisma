// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum Language {
  RU
  TM
  EN
}

enum UserLevel {
  STANDARD
  PRO
  PARTNER
}

enum AdType {
  BUY
  SELL
}

enum PriceType {
  FIXED
  FLOATING
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ExchangeStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionMethod {
  CRYPTO
  CASH
  P2P
  CODE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum CodeStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  telegramId    String   @unique
  username      String?
  firstName     String?
  isVerified   Boolean  @default(false)
  kycStatus    KycStatus @default(NONE)
  kycPhotoUrl  String?  // URL загруженного фото документа
  createdAt    DateTime  @default(now())
  nickname     String?
  avatarUrl    String?
  lastSeen     DateTime @default(now())
  language     Language  @default(RU)

  // Telegram Bot настройки
  phone             String?  // Для верификации
  email             String?  // Для привязки почты
  passcode          String?  // Для 2FA PIN-кода
  isAdmin           Boolean  @default(false) // Для доступа в админку
  tgNotifications   Boolean  @default(true) // Включены ли уведомления
  tgChatId          String?  // Chat ID для отправки уведомлений
  isDeleted         Boolean  @default(false) // Мягкое удаление (Soft Delete)

  // Система уровней
  level         UserLevel @default(STANDARD)
  depositAmount Decimal   @default(0) // Страховой депозит
  dailyLimit    Decimal   @default(150) // Лимит в день
  tradesCount   Int      @default(0) // Количество сделок
  volumeTotal   Decimal   @default(0) // Общий объём

  wallet       Wallet?
  ads          P2PAd[]

  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  messages       Message[]
  reviewsGiven   Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  exchangeRequests ExchangeRequest[]
  cryptoTransactions CryptoTransaction[]
  
  // Коды (ваучеры)
  createdCodes  Code[] @relation("CreatedCodes")
  redeemedCodes Code[] @relation("RedeemedCodes")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  usdtBalance  Decimal  @default(0.0)
  tmtBalance   Decimal  @default(0.0)
  bonusBalance Decimal  @default(15.0) // Приветственный бонус

  withdrawalAddresses WithdrawalAddress[]
}

model WithdrawalAddress {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  network   String   // TRC20, BEP20, ERC20, APTOS
  address   String
  label     String?  // Пользовательская метка
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([walletId, address])
  @@index([walletId])
}

model P2PAd {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        AdType   
  asset       String   
  fiat        String   
  priceType   PriceType   
  price       Decimal  // Если priceType == 'floating', здесь хранится маржа (например, 1.5%)
  minLimit    Decimal    
  maxLimit    Decimal    
  city        String   
  autoReply   String?  
  
  // НОВЫЕ ПОЛЯ (Умный маркет)
  description  String?  // Условия сделки
  paymentTime  Int      @default(15) // Время на оплату в минутах
  isPrivate    Boolean  @default(false) // Приватное объявление по ссылке
  reqKyc       Boolean  @default(false) // Требовать верификацию
  reqMinTrades Int      @default(0)     // Минимум сделок у контрагента
  reqRating    Decimal  @default(0.0)   // Минимальный рейтинг контрагента

  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false) // Мягкое удаление
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id          String   @id @default(uuid())
  adId        String
  ad          P2PAd    @relation(fields: [adId], references: [id])
  buyerId     String
  buyer       User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id])

  amountAsset Decimal    
  amountFiat  Decimal    
  status      OrderStatus @default(PENDING) 
  
  isDisputed  Boolean  @default(false) // НОВОЕ: Нажат ли "Спор/Апелляция"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  reviews     Review[]
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  text      String?
  imageUrl  String?  // URL загруженного изображения
  isSystem  Boolean  @default(false) // НОВОЕ: Системные сообщения (например автоответчик)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Restrict)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Restrict)
  rating    String   
  comment   String?
  createdAt DateTime @default(now())
}

model ExchangeRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  direction   String   // 'USDT_TO_TMT' или 'TMT_TO_USDT'
  amountUsdt  Decimal
  amountTmt   Decimal
  
  // Для USDT_TO_TMT: номер пользователя, куда админ отправит манаты
  userPhone   String?  
  
  status      ExchangeStatus @default(PENDING)
  commission  Decimal  @default(0) // Комиссия за обмен (в USDT)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique // 'EXCHANGE_RATE', 'EXCHANGE_FEE'
  value String
}

model CryptoTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  type      TransactionType
  method    TransactionMethod @default(CRYPTO)
  asset     String   @default("USDT")
  network   String?  // 'TRC20', 'BEP20' или 'APTOS'

  amount    Decimal
  fee       Decimal  @default(0) // Комиссия
  address   String?  // Куда выводить (для WITHDRAWAL)
  txId      String?  // Хэш транзакции (для DEPOSIT)

  city      String?  // Для CASH: город (Ашхабад, Туркменабад, Мары, Дашогуз, Балканабад)
  code      String?  // Для CODE: код пополнения

  status    TransactionStatus @default(PENDING)
  adminNote String?  // Заметка админа

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

// Коды для наличных расчетов (ваучеры)
model Code {
  id          String   @id @default(uuid())
  code        String   @unique // Сам код (например, TM-USDT-500-A7B8-C9D1-E2F3)
  codeHash    String   @unique // Хешированный код для безопасности
  
  amount      Decimal  // Номинал кода
  currency    String   @default("USDT") // Валюта кода
  
  fee         Decimal  @default(0) // Комиссия за создание
  status      CodeStatus @default(ACTIVE)
  
  creatorId   String   // Кто создал код
  creator     User     @relation("CreatedCodes", fields: [creatorId], references: [id], onDelete: Restrict)
  
  redeemerId  String?  // Кто активировал код
  redeemer    User?    @relation("RedeemedCodes", fields: [redeemerId], references: [id], onDelete: SetNull)
  
  expiresAt   DateTime // Срок действия кода
  
  createdAt   DateTime @default(now())
  usedAt      DateTime? // Когда был использован
  
  @@index([code])
  @@index([codeHash])
  @@index([status])
}