// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
}

model User {
  id          String   @id @default(uuid())
  telegramId  String   @unique
  username    String?
  firstName   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  nickname    String?  
  avatarUrl   String?  
  
  // Новые поля из PDF
  phone       String?  // Для верификации
  passcode    String?  // Для 2FA PIN-кода
  isAdmin     Boolean  @default(false) // Для доступа в админку

  wallet      Wallet?
  ads         P2PAd[]
  
  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  messages       Message[]
  reviewsGiven   Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usdtBalance Float    @default(0.0)
  tmtBalance  Float    @default(0.0)
}

model P2PAd {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   
  asset       String   
  fiat        String   
  priceType   String   
  price       Float    // Если priceType == 'floating', здесь хранится маржа (например, 1.5%)
  minLimit    Float    
  maxLimit    Float    
  city        String   
  autoReply   String?  
  
  // НОВЫЕ ПОЛЯ (Умный маркет)
  description  String?  // Условия сделки
  paymentTime  Int      @default(15) // Время на оплату в минутах
  isPrivate    Boolean  @default(false) // Приватное объявление по ссылке
  reqKyc       Boolean  @default(false) // Требовать верификацию
  reqMinTrades Int      @default(0)     // Минимум сделок у контрагента
  reqRating    Float    @default(0.0)   // Минимальный рейтинг контрагента

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id          String   @id @default(uuid())
  adId        String
  ad          P2PAd    @relation(fields: [adId], references: [id])
  buyerId     String
  buyer       User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id])

  amountAsset Float    
  amountFiat  Float    
  status      String   @default("PENDING") 
  
  isDisputed  Boolean  @default(false) // НОВОЕ: Нажат ли "Спор/Апелляция"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  reviews     Review[]
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  isSystem  Boolean  @default(false) // НОВОЕ: Системные сообщения (например автоответчик)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  rating    String   
  comment   String?
  createdAt DateTime @default(now())
}