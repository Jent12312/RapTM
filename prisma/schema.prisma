// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
}

model User {
  id            String   @id @default(uuid())
  telegramId    String   @unique
  username      String?
  firstName     String?
  isVerified   Boolean  @default(false)
  kycStatus    String   @default("none") // none, pending, verified, rejected
  kycPhotoUrl  String?  // URL загруженного фото документа
  createdAt    DateTime  @default(now())
  nickname     String?
  avatarUrl    String?
  lastSeen     DateTime @default(now())
  language     String   @default("ru") // ru, tm, en

  // Telegram Bot настройки
  phone             String?  // Для верификации
  email             String?  // Для привязки почты
  passcode          String?  // Для 2FA PIN-кода
  isAdmin           Boolean  @default(false) // Для доступа в админку
  tgNotifications   Boolean  @default(true) // Включены ли уведомления
  tgChatId          String?  // Chat ID для отправки уведомлений

  // Система уровней
  level         String   @default("Standard") // Standard, Pro, Partner
  depositAmount Float    @default(0) // Страховой депозит
  dailyLimit    Float    @default(150) // Лимит в день
  tradesCount   Int      @default(0) // Количество сделок
  volumeTotal   Float    @default(0) // Общий объём

  wallet       Wallet?
  ads          P2PAd[]

  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  messages       Message[]
  reviewsGiven   Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  exchangeRequests ExchangeRequest[]
  cryptoTransactions CryptoTransaction[]
  
  // Коды (ваучеры)
  createdCodes  Code[] @relation("CreatedCodes")
  redeemedCodes Code[] @relation("RedeemedCodes")
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usdtBalance  Float    @default(0.0)
  tmtBalance   Float    @default(0.0)
  bonusBalance Float    @default(15.0) // Приветственный бонус

  withdrawalAddresses WithdrawalAddress[]
}

model WithdrawalAddress {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  network   String   // TRC20, BEP20, ERC20, APTOS
  address   String
  label     String?  // Пользовательская метка
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([walletId, address])
  @@index([walletId])
}

model P2PAd {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   
  asset       String   
  fiat        String   
  priceType   String   
  price       Float    // Если priceType == 'floating', здесь хранится маржа (например, 1.5%)
  minLimit    Float    
  maxLimit    Float    
  city        String   
  autoReply   String?  
  
  // НОВЫЕ ПОЛЯ (Умный маркет)
  description  String?  // Условия сделки
  paymentTime  Int      @default(15) // Время на оплату в минутах
  isPrivate    Boolean  @default(false) // Приватное объявление по ссылке
  reqKyc       Boolean  @default(false) // Требовать верификацию
  reqMinTrades Int      @default(0)     // Минимум сделок у контрагента
  reqRating    Float    @default(0.0)   // Минимальный рейтинг контрагента

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id          String   @id @default(uuid())
  adId        String
  ad          P2PAd    @relation(fields: [adId], references: [id])
  buyerId     String
  buyer       User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id])

  amountAsset Float    
  amountFiat  Float    
  status      String   @default("PENDING") 
  
  isDisputed  Boolean  @default(false) // НОВОЕ: Нажат ли "Спор/Апелляция"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  reviews     Review[]
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String?
  imageUrl  String?  // URL загруженного изображения
  isSystem  Boolean  @default(false) // НОВОЕ: Системные сообщения (например автоответчик)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  rating    String   
  comment   String?
  createdAt DateTime @default(now())
}

model ExchangeRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  direction   String   // 'USDT_TO_TMT' или 'TMT_TO_USDT'
  amountUsdt  Float
  amountTmt   Float
  
  // Для USDT_TO_TMT: номер пользователя, куда админ отправит манаты
  userPhone   String?  
  
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  commission  Float    @default(0) // Комиссия за обмен (в USDT)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique // 'EXCHANGE_RATE', 'EXCHANGE_FEE'
  value String
}

model CryptoTransaction {
  id        String   @id @default(uuid())
  userId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // 'DEPOSIT' (Пополнение) или 'WITHDRAWAL' (Вывод)
  method    String   @default("CRYPTO") // CRYPTO, CASH, P2P, CODE
  asset     String   @default("USDT")
  network   String?  // 'TRC20', 'BEP20' или 'APTOS'

  amount    Float
  fee       Float    @default(0) // Комиссия
  address   String?  // Куда выводить (для WITHDRAWAL)
  txId      String?  // Хэш транзакции (для DEPOSIT)

  city      String?  // Для CASH: город (Ашхабад, Туркменабад, Мары, Дашогуз, Балканабад)
  code      String?  // Для CODE: код пополнения

  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED, FAILED
  adminNote String?  // Заметка админа

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

// Коды для наличных расчетов (ваучеры)
model Code {
  id          String   @id @default(uuid())
  code        String   @unique // Сам код (например, TM-USDT-500-A7B8-C9D1-E2F3)
  codeHash    String   @unique // Хешированный код для безопасности
  
  amount      Float    // Номинал кода
  currency    String   @default("USDT") // Валюта кода
  
  fee         Float    @default(0) // Комиссия за создание
  status      String   @default("ACTIVE") // ACTIVE, USED, EXPIRED, CANCELLED
  
  creatorId   String   // Кто создал код
  creator     User     @relation("CreatedCodes", fields: [creatorId], references: [id], onDelete: Cascade)
  
  redeemerId  String?  // Кто активировал код
  redeemer    User?    @relation("RedeemedCodes", fields: [redeemerId], references: [id], onDelete: SetNull)
  
  expiresAt   DateTime // Срок действия кода
  
  createdAt   DateTime @default(now())
  usedAt      DateTime? // Когда был использован
  
  @@index([code])
  @@index([codeHash])
  @@index([status])
}