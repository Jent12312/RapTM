// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL") // Используем прямую ссылку на базу
}

// 1. Модель Пользователя
model User {
  id          String   @id @default(uuid())
  telegramId  String   @unique // Храним как String, чтобы не было багов с большими числами
  username    String?
  firstName   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Связи
  wallet      Wallet?
  ads         P2PAd[]
}

// 2. Модель Кошелька (Один к одному с Пользователем)
model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  usdtBalance Float    @default(0.0) // Баланс Крипты
  tmtBalance  Float    @default(0.0) // Баланс внутреннего TMT
}

// 3. Модель P2P Объявления (Один ко многим от Пользователя)
model P2PAd {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   // "buy" (Покупает) или "sell" (Продает)
  asset       String   // "USDT" или "TMT"
  fiat        String   // "TMT" или "USD"
  priceType   String   // "fixed" или "floating"
  
  price       Float    // Курс
  minLimit    Float    // Минимальная сумма
  maxLimit    Float    // Максимальная сумма
  city        String   // Город (Наличные)
  autoReply   String?  // Автоответ

  isActive    Boolean  @default(true) // Включено или выключено
  createdAt   DateTime @default(now())
}