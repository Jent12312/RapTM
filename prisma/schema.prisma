// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
}

model User {
  id          String   @id @default(uuid())
  telegramId  String   @unique
  username    String?
  firstName   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  nickname    String?  // Новое поле для ручного изменения
  avatarUrl   String?  // Ссылка на аву

  wallet      Wallet?
  ads         P2PAd[]
  
  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  // Новое: Сообщения в чате и Отзывы
  messages       Message[]
  reviewsGiven   Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usdtBalance Float    @default(0.0)
  tmtBalance  Float    @default(0.0)
}

model P2PAd {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   
  asset       String   
  fiat        String   
  priceType   String   
  price       Float    
  minLimit    Float    
  maxLimit    Float    
  city        String   
  autoReply   String?  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id          String   @id @default(uuid())
  adId        String
  ad          P2PAd    @relation(fields: [adId], references: [id])
  buyerId     String
  buyer       User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id])

  amountAsset Float    
  amountFiat  Float    
  status      String   @default("PENDING") 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Новое: Чат и Отзыв к этой сделке
  messages    Message[]
  review      Review?
}

// НОВАЯ МОДЕЛЬ: Сообщения Чата
model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  text      String
  createdAt DateTime @default(now())
}

// НОВАЯ МОДЕЛЬ: Отзывы (Смайлики)
model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique // Один отзыв на одну сделку
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  
  rating    String   // "GOOD" (Smile), "NEUTRAL" (Meh), "BAD" (Frown)
  comment   String?
  createdAt DateTime @default(now())
}